# CitaSpot — Variables de entorno para Coolify
# Copiar cada variable en: Coolify UI → Recurso Docker Compose → Environment Variables
# Las variables marcadas con *** son SECRETAS — nunca compartirlas públicamente

# ── GitHub Container Registry ────────────────────────────────────────────────
# Tu username de GitHub (propietario de las imágenes en GHCR)
GITHUB_OWNER=tu-github-username

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
POSTGRES_USER=citaspot
POSTGRES_PASSWORD=***cambia-esto***

# ── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_PASSWORD=***cambia-esto***

# ── Message Queue (RabbitMQ) ─────────────────────────────────────────────────
RABBITMQ_USER=citaspot
RABBITMQ_PASS=***cambia-esto***

# ── JWT / Supabase Auth ───────────────────────────────────────────────────────
# JWT_SECRET = Supabase → Settings → API → JWT Settings → JWT Secret
JWT_SECRET=***desde-supabase***

# ── Supabase (servidor) ───────────────────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=***service-role-key***
SUPABASE_ANON_KEY=***anon-key***

# ── Supabase (frontend / NEXT_PUBLIC) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=***anon-key***

# ── URLs públicas ─────────────────────────────────────────────────────────────
# URL base del Core API — usada por el frontend
NEXT_PUBLIC_API_URL=https://api.citaspot.com
# URL de este servidor — Evolution API enviará webhooks aquí (incluir /api/v1/whatsapp/webhook)
WEBHOOK_URL=https://api.citaspot.com/api/v1/whatsapp/webhook

# ── Evolution API (WhatsApp) ─────────────────────────────────────────────────
# API key para autenticar llamadas a Evolution API
EVOLUTION_API_KEY=***cambia-esto***
# Secret para validar webhooks entrantes de Evolution (dejar vacío en dev)
WEBHOOK_SECRET=***cambia-esto***

# ── LLM Keys ─────────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=***desde-google-ai-studio***
# https://platform.openai.com/api-keys
OPENAI_API_KEY=***desde-openai***

# ── Pagos ─────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_***
STRIPE_WEBHOOK_SECRET=whsec_***
# IDs de precios en Stripe (dashboard.stripe.com/products)
STRIPE_PRICE_STARTER=price_***
STRIPE_PRICE_PRO=price_***
# https://www.mercadopago.com/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=***desde-mercadopago***

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://citaspot.com,https://www.citaspot.com

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=***cambia-esto***
# Debe coincidir con el password del usuario grafana_user en PostgreSQL
# Después del primer deploy: docker exec -it citaspot_postgres psql -U citaspot -c "ALTER USER grafana_user PASSWORD '<valor>';"
GRAFANA_DB_PASSWORD=***cambia-esto***
GRAFANA_DOMAIN=grafana.citaspot.com
