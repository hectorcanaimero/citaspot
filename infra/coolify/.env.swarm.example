# CitaSpot — Variables de entorno para el servidor Swarm (Portainer)
# Usar en: Portainer → Stack → Environment variables
# O: docker stack deploy con estas vars exportadas en el shell
#
# IMPORTANTE: reemplazar <COOLIFY_IP> con la IP privada del servidor Coolify
# Si el proveedor ofrece red privada (Hetzner Private Network, DO VPC),
# usar la IP privada (10.x.x.x). De lo contrario, usar la IP pública.

# ── Conexiones al servidor Coolify ──────────────────────────────────────────
DATABASE_URL=postgresql://citaspot:<POSTGRES_PASSWORD>@<COOLIFY_IP>:5432/citaspot
REDIS_URL=redis://:<REDIS_PASSWORD>@<COOLIFY_IP>:6379
RABBITMQ_URL=amqp://citaspot:<RABBITMQ_PASS>@<COOLIFY_IP>:5672/

# ── Evolution API (corre en Coolify, se llama por URL pública) ───────────────
EVOLUTION_API_URL=https://evolution.citaspot.com
EVOLUTION_API_KEY=***cambia-esto***
WEBHOOK_URL=https://api.citaspot.com/api/v1/whatsapp/webhook
WEBHOOK_SECRET=***cambia-esto***

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=***desde-supabase***
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=***service-role-key***
SUPABASE_ANON_KEY=***anon-key***

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.citaspot.com
# NEXT_PUBLIC_SUPABASE_URL y ANON_KEY se derivan de SUPABASE_URL y SUPABASE_ANON_KEY

# ── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=***desde-google-ai-studio***
OPENAI_API_KEY=sk-proj-***

# ── Pagos ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_***
STRIPE_WEBHOOK_SECRET=whsec_***
STRIPE_PRICE_STARTER=price_***
STRIPE_PRICE_PRO=price_***

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://citaspot.com,https://www.citaspot.com

# ── GitHub Container Registry ─────────────────────────────────────────────────
GITHUB_OWNER=tu-github-username
