{
  "uid": "citaspot-appointments",
  "title": "Citas & Operaciones",
  "description": "Volumen de citas, status, ingresos y canales de origen",
  "tags": ["citaspot", "appointments", "operations"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Citas (período)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM appointments WHERE $__timeFilter(starts_at)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tasa de No-Show",
      "description": "no_show / total × 100",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 20 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
          "format": "table",
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE status = 'no_show') / NULLIF(COUNT(*), 0), 1) AS value FROM appointments WHERE $__timeFilter(starts_at)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ingresos Estimados (período)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(price), 0) AS value FROM appointments WHERE $__timeFilter(starts_at) AND status = 'completed'",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tasa de Confirmación",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 75 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
          "format": "table",
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE status IN ('confirmed', 'completed')) / NULLIF(COUNT(*), 0), 1) AS value FROM appointments WHERE $__timeFilter(starts_at)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Citas por Día",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
          "format": "time_series",
          "rawSql": "SELECT day AS time, SUM(total) AS \"Total\", SUM(completed) AS \"Completadas\", SUM(cancelled) AS \"Canceladas\", SUM(no_show) AS \"No-Show\" FROM rpt_appointments_daily WHERE $__timeFilter(day) GROUP BY day ORDER BY day",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Por Canal de Origen",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
          "format": "table",
          "rawSql": "SELECT source AS metric, COUNT(*) AS value FROM appointments WHERE $__timeFilter(starts_at) GROUP BY source ORDER BY value DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingresos Estimados por Día (USD)",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 13 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
          "format": "time_series",
          "rawSql": "SELECT day AS time, SUM(revenue) AS \"Ingresos\" FROM rpt_appointments_daily WHERE $__timeFilter(day) GROUP BY day ORDER BY day",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 10 Tenants por Citas",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
      "options": { "sortBy": [{ "displayName": "Citas", "desc": true }], "footer": { "show": false } },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "total_appointments" }, "properties": [{ "id": "displayName", "value": "Citas" }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "citaspot-postgres" },
          "format": "table",
          "rawSql": "SELECT name, total_appointments FROM rpt_tenant_kpis ORDER BY total_appointments DESC LIMIT 10",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "timepicker": {}
}
