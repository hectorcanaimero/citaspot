# CitaSpot — Plantilla de variables de entorno
# Copiar este archivo como .env y completar los valores
# NUNCA commitear el .env con valores reales

# ── JWT / Supabase Auth ──────────────────────────────────────────
# JWT_SECRET = el JWT Secret de Supabase (Settings > API > JWT Settings > JWT Secret)
# Usado por el Core API para validar tokens del dashboard
JWT_SECRET=

# ── Supabase — Core API (servidor) ───────────────────────────────
# Obtener en: https://supabase.com/dashboard/project/_/settings/api
# SUPABASE_URL: Project URL (ej: https://xxxxx.supabase.co)
SUPABASE_URL=
# SERVICE_ROLE_KEY: key secreta con acceso admin. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# ANON_KEY: key pública para sign-in desde el servidor
SUPABASE_ANON_KEY=

# ── Supabase — Frontend (Next.js) ────────────────────────────────
# Mismos valores que arriba pero con prefijo NEXT_PUBLIC_ para el browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Evolution API (WhatsApp) ─────────────────────────────────────
# Obtener de tu instancia de Evolution API
EVOLUTION_API_KEY=
EVOLUTION_API_URL=http://localhost:8080
# URL pública de este servidor — Evolution usará esta URL para enviar eventos a cada instancia.
# Dejar vacío en desarrollo local (se usará el webhook global configurado en Evolution).
# Ejemplo producción: https://api.tudominio.com
WEBHOOK_URL=

# ── LLM Keys ─────────────────────────────────────────────────────
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Pagos ────────────────────────────────────────────────────────
# Stripe: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# MercadoPago: https://www.mercadopago.com/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=

# ── Configuración de la aplicación ──────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
PORT=3001
AI_SERVICE_PORT=8001
# CORS: orígenes permitidos separados por coma (vacío = en dev localhost:3000, en prod *)
# Ejemplo: CORS_ORIGINS=http://localhost:3000,https://app.citaspot.com
# CORS_ORIGINS=

# ── Grafana (Reportes) ───────────────────────────────────────────
# Password del admin de Grafana (login en http://localhost:3100)
GRAFANA_ADMIN_PASSWORD=
# Password del usuario grafana_user en PostgreSQL (creado por migración 014)
# En dev el valor por defecto es 'grafana_dev' (ver migración 014)
# En prod, después de make migrate: ALTER USER grafana_user PASSWORD '<este valor>';
GRAFANA_DB_PASSWORD=
# Dominio público de Grafana (solo prod — ej: grafana.tudominio.com)
# GRAFANA_DOMAIN=

# ── MinIO (storage de assets de tenants — logos, portadas) ───────
# Endpoint del servidor MinIO (host:port, sin scheme — el SDK arma la URL)
# Dev:  localhost:9000
# Prod: s3.tudominio.com
MINIO_ENDPOINT=
# Credenciales — generar en MinIO Console → Access Keys
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# true en prod (HTTPS), false en dev (HTTP)
MINIO_USE_SSL=false
# Bucket donde se guardan logos / portadas. El backend lo crea al startup si no existe.
MINIO_BUCKET=citaspot-tenant-assets
# URL pública para servir los assets al browser. Útil cuando MINIO_ENDPOINT es interno.
# Ejemplo: https://s3.tudominio.com  o  https://assets.citaspot.com
MINIO_PUBLIC_URL=
PLANE_GURIA_KEY